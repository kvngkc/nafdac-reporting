DATABASE_URL="postgresql://nafdac:nafdac@localhost:5432/nafdac?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Salt used to hash reporter IPs for rate limiting (never store raw IPs)
IP_HASH_SALT="change-me-too"

# Seeded admin account (prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# Insert ~240 fictional complaints for local demos. Never enable in production.
SEED_DEMO_DATA="false"

# Evidence storage: "local" (writes to ./uploads) or "s3"
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# Cloudflare Turnstile — leave blank to disable CAPTCHA (dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
